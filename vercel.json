{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/en",
      "destination": "/index.html"
    },
    {
      "source": "/de",
      "destination": "/index.html"
    },
    {
      "source": "/fr",
      "destination": "/index.html"
    },
    {
      "source": "/es",
      "destination": "/index.html"
    },
    {
      "source": "/it",
      "destination": "/index.html"
    },
    {
      "source": "/nl",
      "destination": "/index.html"
    },
    {
      "source": "/pl",
      "destination": "/index.html"
    }
  ]
}
